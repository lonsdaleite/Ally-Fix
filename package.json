{
  "name": "ally-fix",
  "version": "1.0.3",
  "description": "One-click fixes for the ROG Xbox Ally X on SteamOS",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonsdaleite/Ally-Fix.git"
  },
  "keywords": ["decky", "plugin", "rog-ally", "steamos"],
  "author": "lonsdaleite",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lonsdaleite/Ally-Fix/issues"
  },
  "homepage": "https://github.com/lonsdaleite/Ally-Fix#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.6",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  },
  "packageManager": "pnpm@9.4.0"
}
